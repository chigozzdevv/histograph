HISTOGRAPH_TEMPORAL_ADDRESS=localhost:7233
HISTOGRAPH_TEMPORAL_NAMESPACE=default
HISTOGRAPH_TEMPORAL_TASK_QUEUE=histograph-runs
HISTOGRAPH_S3_ENDPOINT_URL=http://localhost:9000
HISTOGRAPH_S3_BUCKET=histograph-evidence
HISTOGRAPH_S3_REGION=us-east-1
HISTOGRAPH_S3_ACCESS_KEY_ID=histograph
HISTOGRAPH_S3_SECRET_ACCESS_KEY=replace-with-a-high-entropy-object-store-secret
HISTOGRAPH_GITHUB_APP_ID=
HISTOGRAPH_GITHUB_PRIVATE_KEY=
HISTOGRAPH_GITHUB_WEBHOOK_SECRET=
HISTOGRAPH_GITHUB_API_URL=https://api.github.com
HISTOGRAPH_GITHUB_API_VERSION=2026-03-10
HISTOGRAPH_GITHUB_INSTALL_URL=
HISTOGRAPH_PUBLIC_APP_URL=http://localhost:3000
HISTOGRAPH_OIDC_ISSUER=
HISTOGRAPH_OIDC_AUDIENCE=
